# 跨平台协作：文本文件统一 LF，Windows 开发者 checkout 不转换
* text=auto eol=lf

# shell 脚本必须 LF（否则 CI / MSYS 执行失败）
gradlew text eol=lf
*.sh text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.jar binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.ttf binary
*.woff binary
*.woff2 binary
*.gz binary
*.zip binary

# GitHub 语言统计与 diff：标记生成物
package-lock.json linguist-generated=true -diff
android/app/src/main/assets/public/** linguist-generated=true -diff
