root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gradle,groovy,java,kt,xml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc,ts,tsx,js,jsx,css,html}]
indent_size = 2

[Makefile]
indent_style = tab
